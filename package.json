{
  "name": "ticketdeck",
  "version": "0.1.0",
  "description": "Tickets that coding agents create and manage themselves, stored as markdown in your repo.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ticketdeck": "dist/cli.js",
    "ticketdeck-mcp": "dist/mcp.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
